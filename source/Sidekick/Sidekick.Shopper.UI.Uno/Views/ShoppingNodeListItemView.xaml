<UserControl
    x:Class="Sidekick.Shopper.UI.Uno.Views.ShoppingNodeListItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="100"
    d:DesignWidth="400">

    <StackPanel Orientation="Horizontal" Margin="0,8" Spacing="8">

        <!-- Item Image (Component Thumbnail) -->
        <Grid Height="64" Width="64" Background="Gray">
            <Image x:Name="ThumbnailImage" Source="{Binding ThumbnailUri}"/>
        </Grid>
        
        <!-- Details -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Spacing="4">
            <TextBlock Text="{Binding Text}" FontSize="14"/>
            <StackPanel Orientation="Vertical" Spacing="0" VerticalAlignment="Bottom">
                <TextBlock FontSize="12" Foreground="Gray" Text="{Binding DisplayNumber}"/>
                <TextBlock FontSize="12" Foreground="Gray" Text="{Binding Value}"/>
            </StackPanel>
        </StackPanel>

    </StackPanel>

</UserControl>
