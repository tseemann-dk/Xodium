<UserControl
    x:Class="Sidekick.Shopper.UI.Uno.Views.ComponentLookupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sidekick.Shopper.UI.Uno.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Grid Grid.Row="0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox 
                x:Name="SearchTextEntry" 
                Grid.Column="0"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            <Button 
                x:Name="SearchButton" 
                Grid.Column="1"
                Content="Search"
                Command="{Binding SearchCommand}"/>
        </Grid>

        <!-- Result View -->
        <ListView 
            x:Name="FoundComponentsListView" 
            Grid.Row="1"
            ItemsSource="{Binding FoundComponents}"
            SelectedItem="{Binding SelectedComponent, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <local:ComponentListItemView/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Error Message & Buttons -->
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock 
                x:Name="ErrorMessageLabel"
                Foreground="Red"
                Text="{Binding ErrorMessage}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button
                    x:Name="OkButton"
                    Content="OK" 
                    Command="{Binding SubmitCommand}"
                    Width="80"/>
                <Button 
                    x:Name="CancelButton"
                    Content="Cancel" 
                    Command="{Binding CancelCommand}"
                    Width="80"/>
            </StackPanel>
        </StackPanel>

    </Grid>

</UserControl>
